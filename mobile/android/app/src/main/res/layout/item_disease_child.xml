<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/diseaseInfoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/disease_info_title"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/diseaseInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hastalık hakkında bilgi..."
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/dietAdviceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diet_advice_title"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/dietAdviceText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Yeme-içme tavsiyeleri..."
        android:textSize="13sp"
        android:textColor="#666666" />
</LinearLayout>


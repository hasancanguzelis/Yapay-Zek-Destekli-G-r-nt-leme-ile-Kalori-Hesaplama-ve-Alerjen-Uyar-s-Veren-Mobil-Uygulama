<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Rounded, modern shapes -->
    <style name="ShapeAppearance.TezProje.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.TezProje.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.TezProje.Button" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.TezProje.Medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.TezProje.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.TezProje.Medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.TezProje.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Cards -->
    <style name="Widget.TezProje.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearance">@style/ShapeAppearance.TezProje.Large</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/app_outline</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <style name="Widget.TezProje.CardView.Warning" parent="Widget.TezProje.CardView">
        <item name="cardBackgroundColor">@color/warning_bg</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/warning_stroke</item>
    </style>

    <!-- Text inputs -->
    <style name="Widget.TezProje.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Widget.TezProje.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="itemIconTint">@color/bottom_nav_item_colors</item>
        <item name="itemTextColor">@color/bottom_nav_item_colors</item>
        <item name="itemRippleColor">@color/bottom_nav_item_ripple</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

</resources>



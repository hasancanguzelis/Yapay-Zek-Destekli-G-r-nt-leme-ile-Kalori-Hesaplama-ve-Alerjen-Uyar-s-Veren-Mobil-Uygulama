# Opsiyonel: Harici API anahtarları ve ayarlar
USDA_API_KEY=

# Uygulama ortamı: dev / prod
APP_ENV=dev

# CORS (prod'da mutlaka domain bazlı verin; örn: https://example.com)
# Virgülle ayırabilirsiniz.
# Dev varsayılanı: *
CORS_ALLOW_ORIGINS=*

# Prod'da genelde false tutun.
CORS_ALLOW_CREDENTIALS=true

# Harici API çağrıları için timeout/retry
HTTP_TIMEOUT_S=15
HTTP_RETRIES=2
HTTP_RETRY_BACKOFF_S=0.4

# --- PROD ÖRNEĞİ (ÖNERİLEN) ---
# APP_ENV=prod
# CORS_ALLOW_ORIGINS=https://tezproje.example.com
# CORS_ALLOW_CREDENTIALS=false
# HTTP_TIMEOUT_S=10
# HTTP_RETRIES=1
# HTTP_RETRY_BACKOFF_S=0.25

# Tesseract yolu (Windows için örnek):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# OCR dili (varsayılan: eng). Türkçe için: tur (Tesseract language pack gerekli)
TESSERACT_LANG=eng

# Alerjen sınıflandırma modeli (joblib) yolu (opsiyonel).
# Varsayılan: backend/models/allergen_clf.joblib
ALLERGEN_MODEL_PATH=

# Tabaklı yemek kalorisi modeli (joblib) yolu (opsiyonel).
# Varsayılan: backend/models/meal_calorie_model.joblib
MEAL_CALORIE_MODEL_PATH=


